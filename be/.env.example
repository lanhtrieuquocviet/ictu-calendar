# App
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_strong_db_password
DB_NAME=ictu_calendar

# Admin seed (tạo tự động khi khởi động lần đầu)
ADMIN_EMAIL=admin@ictu.edu.vn
ADMIN_PASSWORD=Admin@ChangeMeNow123!
ADMIN_FULLNAME=Administrator

# JWT — sinh key ngẫu nhiên: node -e "require('crypto').randomBytes(64).toString('base64') |> console.log"
JWT_SECRET=replace_with_random_64_byte_base64_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_random_64_byte_base64_string
JWT_REFRESH_EXPIRES_IN=30d

# Mail (Gmail SMTP)
# Để trống MAIL_USER / MAIL_PASS nếu chưa muốn bật tính năng gửi mail
# Tạo App Password tại: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# URL frontend (dùng cho CORS)
FRONTEND_URL=http://localhost:4200

# Local Storage (file đính kèm)
# /app/uploads  ← dùng khi chạy qua docker-compose (volume mount)
# ./uploads     ← dùng khi chạy backend local (npm run start:dev)
UPLOAD_DIR=/app/uploads

# Google OAuth (đăng nhập Google + đồng bộ Google Calendar)
# Tạo credentials tại: https://console.cloud.google.com/apis/credentials
# Để trống nếu không dùng tính năng Google Login / Google Calendar Sync
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Callback URL phải khớp với Authorized redirect URIs trong Google Cloud Console
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback
GOOGLE_CALENDAR_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/calendar/callback

