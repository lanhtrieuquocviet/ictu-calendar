# ── Dùng cho docker-compose.yml ─────────────────────────────────────────────
# Copy file này thành .env ở thư mục gốc rồi điền giá trị thực

# Database
DB_PASSWORD=your_strong_db_password
DB_NAME=ictu_calendar

# MinIO credentials (phải khớp với MINIO_ACCESS_KEY / MINIO_SECRET_KEY trong be/.env)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_strong_minio_secret
